<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Con qué se dibuja un push que no traiga icono ni color propios.
             Sin esto Android usa el icono del lanzador, que al aplanarlo a un
             solo color se ve como un cuadrado blanco. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_jobo" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/jobo_verde" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permisos -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sacar una foto para el perfil, una solicitud o el chat. Elegir una de
         la galería no necesita permiso: lo resuelve el selector del sistema. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Solo la aproximada. Se usa nada más que para adivinar la localidad
         más cercana del catálogo, y nunca se guardan las coordenadas; pedir
         la precisa además obliga a justificarla ante Google Play. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
</manifest>
