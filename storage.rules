rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isImageUnder(mb) {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < mb * 1024 * 1024;
    }

    // Fotos de perfil y de trabajos del profesional.
    match /users/{uid}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder(5);
    }

    // Adjuntos de solicitudes y chats: solo usuarios autenticados.
    match /requests/{requestId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder(5);
    }

    match /chats/{chatId}/{fileName} {
      allow read: if signedIn();
      allow write: if signedIn() && isImageUnder(5);
    }
  }
}
